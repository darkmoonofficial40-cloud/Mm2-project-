        end
        local ok, cfg = pcall(function() return cm:CreateConfig(name) end)
        if not ok or not cfg then
            toast("Dark Moon Config", "Could not create config '" .. name .. "'.", "triangle-alert")
            return nil
        end
        for _, entry in ipairs(Hub.registry) do
            pcall(function() cfg:Register(entry.key, entry.element) end)
        end
        return cfg
    end

    local initialConfigs = listConfigs()
    if #initialConfigs == 0 then
        initialConfigs = {"default"}
    end

    local ConfigDropdown
    local function refreshConfigs(select)
        local names = listConfigs()
        if #names == 0 then
            names = {"default"}
        end
        pcall(function() ConfigDropdown:Refresh(names) end)
        if select then
            selectedConfig = select
            pcall(function() ConfigDropdown:Select(select) end)
        end
    end

    ConfigDropdown = SettingsTab:Dropdown({
        Title = "Config",
        Desc = "Pick a saved config.",
        Values = initialConfigs,
        Value = initialConfigs[1],
        Callback = function(v)
            selectedConfig = cleanName(v)
        end,
    })
    selectedConfig = initialConfigs[1]

    SettingsTab:Input({
        Title = "New Config Name",
        Desc = "Type a name, then press Create & Save.",
        Placeholder = "my-config",
        Value = "",
        Callback = function(v)
            newConfigName = cleanName(v)
        end,
    })

    SettingsTab:Button({
        Title = "Create & Save",
        Desc = "Save all current settings under the new name.",
        Icon = "file-plus",
        Callback = function()
            if newConfigName == "" then
                toast("Dark Moon Config", "Enter a config name first.", "triangle-alert")
                return
            end
            local cfg = buildConfig(newConfigName)
            if cfg and pcall(function() cfg:Save() end) then
                toast("Dark Moon Config", "Saved '" .. newConfigName .. "'.", "check")
                refreshConfigs(newConfigName)
            end
        end,
    })

    SettingsTab:Button({
        Title = "Save Config",
        Desc = "Overwrite the selected config with the current settings.",
        Icon = "save",
        Callback = function()
            local name = cleanName(selectedConfig)
            if name == "" then
                return
            end
            local cfg = buildConfig(name)
            if cfg and pcall(function() cfg:Save() end) then
                toast("Dark Moon Config", "Saved '" .. name .. "'.", "check")
                refreshConfigs(name)
            end
        end,
    })

    SettingsTab:Button({
        Title = "Load Config",
        Desc = "Apply the selected config to every setting.",
        Icon = "folder-open",
        Callback = function()
            local name = cleanName(selectedConfig)
            if name == "" then
                return
            end
            local cfg = buildConfig(name)
            if cfg then
                if pcall(function() cfg:Load() end) then
                    toast("Dark Moon Config", "Loaded '" .. name .. "'.", "check")
                else
                    toast("Dark Moon Config", "Config '" .. name .. "' was not found.", "triangle-alert")
                end
            end
        end,
    })

    SettingsTab:Button({
        Title = "Delete Config",
        Desc = "Permanently delete the selected config.",
        Icon = "trash-2",
        Callback = function()
            local name = cleanName(selectedConfig)
            if name == "" then
                return
            end
            local cfg = buildConfig(name)
            if cfg and pcall(function() cfg:Delete() end) then
                toast("Dark Moon Config", "Deleted '" .. name .. "'.", "check")
                refreshConfigs()
            end
        end,
    })

    SettingsTab:Toggle({
        Title = "Auto Load Selected Config",
        Desc = "Load the selected config automatically every time the script is executed.",
        Icon = "rotate-ccw",
        Type = "Checkbox",
        Value = hasFS and isfile(AUTOLOAD_FILE) or false,
        Callback = function(v)
            if not hasFS then
                toast("Dark Moon Config", "Your executor has no file access.", "triangle-alert")
                return
            end
            pcall(function()
                if v then
                    writefile(AUTOLOAD_FILE, cleanName(selectedConfig))
                elseif isfile(AUTOLOAD_FILE) and type(delfile) == "function" then
                    delfile(AUTOLOAD_FILE)
                end
            end)
        end,
    })

    SettingsTab:Button({
        Title = "Reset All Settings",
        Desc = "Restore all UI options to default.",
        Icon = "rotate-ccw",
        Callback = function()
            local count = 0
            for _, entry in ipairs(Hub.registry) do
                if entry.default ~= nil then
                    if pcall(function() entry.element:Set(entry.default) end) then
                        count = count + 1
                    end
                end
            end
            toast("Dark Moon Settings", "Reset " .. count .. " options to default.", "check")
        end,
    })

    -- About
    SettingsTab:Section({Title = "About"})

    SettingsTab:Paragraph({
        Title = "𝔇𝔞𝔯𝔨 𝔐𝔬𝔬𝔫 • Dark Moon Loader",
        Desc = "Created by biyxznd. Toggle the window with the key selected above (default: RightShift).",
    })

    SettingsTab:Button({
        Title = "Join Discord",
        Icon = "link",
        Callback = function()
            if type(setclipboard) == "function" then
                pcall(setclipboard, DiscordLink)
                toast("Dark Moon Discord", "Invite link copied to clipboard.", "check")
            else
                toast("Dark Moon Discord", DiscordLink, "link")
            end
        end,
    })

    SettingsTab:Button({
        Title = "Unload Script",
        Desc = "Close the window and clean up.",
        Icon = "power",
        Callback = function()
            if Hub.cleanup then
                Hub.cleanup()
            end
        end,
    })

    -- Auto-load saved config
    if hasFS then
        local ok, saved = pcall(function()
            if isfile(AUTOLOAD_FILE) then
                return cleanName(readfile(AUTOLOAD_FILE))
            end
        end)
        if ok and type(saved) == "string" and saved ~= "" then
            selectedConfig = saved
            task.delay(1, function()
                if Hub.cleaned then
                    return
                end
                local cfg = buildConfig(saved)
                if cfg and pcall(function() cfg:Load() end) then
                    pcall(function() ConfigDropdown:Select(saved) end)
                    toast("Dark Moon Config", "Auto-loaded '" .. saved .. "'.", "check")
                end
            end)
        end
    end
end

-- =====================================================================
-- Single Unified & Phone-Optimized Frame Loop
-- =====================================================================
do
    local frameCount = 0
    local statsElapsed = 0
    local noclipElapsed = 0

    Hub.track(RunService.RenderStepped:Connect(function(dt)
        if Hub.cleaned then
            return
        end

        local Camera = workspace.CurrentCamera
        if not Camera then
            return
        end

        frameCount += 1
        statsElapsed += dt
        if statsElapsed >= 0.75 then
            local _fps = math.floor((frameCount / statsElapsed) + 0.5)
            local _ping = getPingMs()
            frameCount = 0
            statsElapsed = 0
        end

        local char = LocalPlayer and LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                if hum.WalkSpeed ~= SpeedValue then
                    hum.WalkSpeed = SpeedValue
                end
                if not hum.UseJumpPower then
                    hum.UseJumpPower = true
                end
                if hum.JumpPower ~= JumpValue then
                    hum.JumpPower = JumpValue
                end
            end

            if Noclip then
                noclipElapsed += dt
                if noclipElapsed >= 0.1 then
                    noclipElapsed = 0
                    for _, desc in ipairs(char:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            if SavedCollide[desc] == nil then
                                SavedCollide[desc] = desc.CanCollide
                            end
                            if desc.CanCollide then
                                desc.CanCollide = false
                            end
                        end
                    end
                end
            end
        end

        local screenCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
        local showFov = Aimbot or SilentAim
        Circle.Visible = showFov
        GlowCircle.Visible = showFov

        if showFov then
            Circle.Position = screenCenter
            Circle.Radius = AimFOV
            GlowCircle.Position = screenCenter
            GlowCircle.Radius = AimFOV

            if RainbowFOV then
                local col = Color3.fromHSV((os.clock() % 5) / 5, 1, 1)
                Circle.Color = col
                GlowCircle.Color = col
            else
                local red = Color3.fromRGB(255, 0, 0)
                Circle.Color = red
                GlowCircle.Color = red
            end
        end

        if Crosshair then
            local gap = 4
            local arm = 10
            CrosshairH.From = Vector2.new(screenCenter.X - (gap + arm), screenCenter.Y)
            CrosshairH.To = Vector2.new(screenCenter.X + (gap + arm), screenCenter.Y)
            CrosshairV.From = Vector2.new(screenCenter.X, screenCenter.Y - (gap + arm))
            CrosshairV.To = Vector2.new(screenCenter.X, screenCenter.Y + (gap + arm))
            CrosshairH.Visible = true
            CrosshairV.Visible = true
        else
            CrosshairH.Visible = false
            CrosshairV.Visible = false
        end

        if Aimbot or SilentAim then
            local targetPos = getClosestTarget(screenCenter)
            SilentTargetPos = SilentAim and targetPos or nil
            if targetPos then
                if Aimbot then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                elseif SilentAim and SilentHitChance > 0 then
                    local pullAlpha = math.clamp((getEffectiveHitChance() / 100) * 0.22, 0.04, 0.22)
                    local desiredCF = CFrame.new(Camera.CFrame.Position, targetPos)
                    Camera.CFrame = Camera.CFrame:Lerp(desiredCF, pullAlpha)
                end
            end
        else
            SilentTargetPos = nil
        end

        if not (ESP or SkeletonESP or Tracers) then
            return
        end

        local localRoot = char and char:FindFirstChild("HumanoidRootPart")
        local tracerOrigin = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y)

        for _, p in ipairs(Players:GetPlayers()) do
            local pChar = (p ~= LocalPlayer) and p.Character or nil
            local hrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
            local hum = pChar and pChar:FindFirstChildOfClass("Humanoid")
            local validAlive = (hrp and hum and hum.Health > 0)

            local rootPos, onScreen, topPos, bottomPos, width, height
            if validAlive then
                rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                topPos = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, 3, 0)).Position)
                bottomPos = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, -3.5, 0)).Position)
                if onScreen and rootPos.Z > 0 then
                    height = math.clamp(math.abs(bottomPos.Y - topPos.Y), 14, 600)
                    width = math.clamp(height * 0.55, 10, 400)
                else
                    onScreen = false
                end
            end

            if ESP then
                if not ESPCache[p] then
                    ESPCache[p] = createESPObjects()
                end
                local entry = ESPCache[p]
                if validAlive and onScreen then
                    local boxX = rootPos.X - (width * 0.5)
                    local boxY = topPos.Y
                    local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    local barX = boxX - 5

                    entry.Box.Size = Vector2.new(width, height)
                    entry.Box.Position = Vector2.new(boxX, boxY)
                    entry.Box.Visible = true

                    entry.HpBg.From = Vector2.new(barX, boxY)
                    entry.HpBg.To = Vector2.new(barX, boxY + height)
                    entry.HpBg.Visible = true

                    entry.HpBar.Color = getHealthColor(hpRatio)
                    entry.HpBar.From = Vector2.new(barX, boxY + height - (height * hpRatio))
                    entry.HpBar.To = Vector2.new(barX, boxY + height)
                    entry.HpBar.Visible = true

                    local distText = ""
                    if localRoot then
                        local studs = math.floor((localRoot.Position - hrp.Position).Magnitude)
                        distText = " [" .. tostring(studs) .. "m]"
                    end

                    entry.Label.Text = string.format("%s%s (%dHP)", p.Name, distText, math.floor(hum.Health + 0.5))
                    entry.Label.Position = Vector2.new(rootPos.X, math.max(boxY - 14, 4))
                    entry.Label.Visible = true
                else
                    hideESPEntry(entry)
                end
            elseif ESPCache[p] then
                hideESPEntry(ESPCache[p])
            end

            if SkeletonESP then
                if not SkeletonCache[p] then
                    SkeletonCache[p] = createSkeletonEntry()
                end
                local skel = SkeletonCache[p]
                if validAlive and onScreen then
                    for _, spec in ipairs(SKELETON_BONE_SPECS) do
                        local line = skel[spec.key]
                        local partA = findFirstPart(pChar, spec.a)
                        local partB = findFirstPart(pChar, spec.b)
                        if partA and partB then
                            local posA, visA = Camera:WorldToViewportPoint(partA.Position)
                            local posB, visB = Camera:WorldToViewportPoint(partB.Position)
                            if visA and visB and posA.Z > 0 and posB.Z > 0 then
                                line.From = Vector2.new(posA.X, posA.Y)
                                line.To = Vector2.new(posB.X, posB.Y)
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    end
                else
                    hideSkeletonEntry(skel)
                end
            elseif SkeletonCache[p] then
                hideSkeletonEntry(SkeletonCache[p])
            end

            if Tracers then
                if not TracerCache[p] then
                    TracerCache[p] = createTracerLine()
                end
                local line = TracerCache[p]
                if validAlive and onScreen then
                    line.From = tracerOrigin
                    line.To = Vector2.new(rootPos.X, bottomPos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            elseif TracerCache[p] then
                TracerCache[p].Visible = false
            end
        end
    end)))
end

WindUI:Notify({
    Title = "𝔇𝔞𝔯𝔨 𝔐𝔬𝔬𝔫",
    Content = "Dark Moon Loader ready.",
    Duration = 4,
    Icon = "moon",
})

Hub.cleanup = function()
    if Hub.cleaned then
        return
    end
    Hub.cleaned = true

    Aimbot = false
    SilentAim = false
    SilentTargetPos = nil
    Noclip = false
    ESP = false
    SkeletonESP = false
    Tracers = false
    Crosshair = false

    for _, conn in ipairs(Hub.connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Hub.connections)

    restoreCharacterCollisions()
    clearESP()
    clearSkeletons()
    clearTracers()

    for _, drawingObj in ipairs({Circle, GlowCircle, CrosshairH, CrosshairV}) do
        if drawingObj then
            pcall(function() drawingObj:Remove() end)
        end
    end

    if Hub.genv.darkmoonUnload == Hub.cleanup then
        Hub.genv.darkmoonUnload = nil
    end

    pcall(function() Window:Destroy() end)
end

Hub.genv.darkmoonUnload = Hub.cleanup
pcall(function()
    Window:OnDestroy(function()
        Hub.cleanup()
    end)
end)

pcall(function() Window:SelectTab(1) end)
