		TracerCache[player] = nil
	end
end)

local function WallCheck(position, character)
	if Wallbang then
		return true
	end
	local origin = Camera.CFrame.Position
	local direction = position - origin
	if LocalPlayer.Character then
		RayParams.FilterDescendantsInstances = {LocalPlayer.Character}
	else
		RayParams.FilterDescendantsInstances = {}
	end
	local ray = workspace:Raycast(origin, direction, RayParams)
	if ray then
		return ray.Instance:IsDescendantOf(character)
	end
	return true
end

local function getPingMs()
	local pingVal = 0
	pcall(function()
		local net = Stats and Stats:FindFirstChild("Network")
		if net and net:FindFirstChild("ServerStatsItem") then
			local dataPing = net.ServerStatsItem:FindFirstChild("Data Ping")
			if dataPing and typeof(dataPing.GetValue) == "function" then
				pingVal = math.floor(dataPing:GetValue() + 0.5)
			end
		end
	end)
	return pingVal
end

local function joinAnotherServer(statusCallback)
	task.spawn(function()
		local placeId = game.PlaceId
		local currentJobId = game.JobId
		if statusCallback then
			statusCallback("Finding...")
		end

		local targetJobId = nil
		local httpGetter = game.HttpGet
		if typeof(httpGetter) == "function" then
			pcall(function()
				local url = string.format(
					"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
					placeId
				)
				local raw = httpGetter(game, url)
				local decoded = HttpService:JSONDecode(raw)
				if decoded and typeof(decoded.data) == "table" then
					for _, srv in ipairs(decoded.data) do
						if typeof(srv) == "table"
							and typeof(srv.id) == "string"
							and srv.id ~= currentJobId
							and tonumber(srv.playing)
							and tonumber(srv.maxPlayers)
							and srv.playing < srv.maxPlayers
						then
							targetJobId = srv.id
							break
						end
					end
				end
			end)
		end

		if statusCallback then
			statusCallback("Joining...")
		end

		local ok = false
		if targetJobId then
			ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(placeId, targetJobId, LocalPlayer)
			end)
		end
		if not ok then
			pcall(function()
				TeleportService:Teleport(placeId, LocalPlayer)
			end)
		end
	end)
end

