local function clearESP()
	for player, entry in pairs(ESPCache) do
		if entry then
			if entry.Box then
				pcall(function() entry.Box:Remove() end)
			end
			if entry.Label then
				pcall(function() entry.Label:Remove() end)
			end
		end
		ESPCache[player] = nil
	end
end

