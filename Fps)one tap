local sharedRayParams = RaycastParams.new()
sharedRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function WallCheck(position, character)
    local cam = workspace.CurrentCamera
    if not cam then
        return true
    end
    local origin = cam.CFrame.Position
    local direction = position - origin
    sharedRayParams.FilterDescendantsInstances = LocalPlayer.Character and {LocalPlayer.Character} or {}
    local ray = workspace:Raycast(origin, direction, sharedRayParams)
    if ray then
        return ray.Instance:IsDescendantOf(character)
    end
    return true
end

local function getClosestTarget(screenCenter)
    local cam = workspace.CurrentCamera
    if not cam then
        return nil
    end

    local closestPart = nil
    local shortestDistance = AimFOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, visible = cam:WorldToViewportPoint(head.Position)
                if visible and pos.Z > 0 and WallCheck(head.Position, player.Character) then
                    local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPart = head
                    end
                end
            end
        end
    end

    if not closestPart then
        return nil
    end

    local aimPosition = closestPart.Position
    if Prediction then
        local velocity = closestPart.AssemblyLinearVelocity
        local distance = (cam.CFrame.Position - closestPart.Position).Magnitude
        local time = distance / math.max(BulletSpeed, 1)
        aimPosition = closestPart.Position + (velocity * time)
    end

    return aimPosition
end

local function getEffectiveHitChance()
    if SilentHitChance >= 100 then
        return 100
    end
    if SilentHitChance <= 0 then
        return 0
    end
    local norm = SilentHitChance / 100
    local boosted = math.pow(norm, 0.55) * 100
    return math.clamp(boosted, 10, 99.5)
end

local function rollSilentHitChance()
    local eff = getEffectiveHitChance()
    if eff >= 100 then
        return true
    end
    if eff <= 0 then
        return false
    end
    return (math.random() * 100) <= eff
end

-- Safe Silent Aim __namecall Hook (when supported by executor)
do
    local hookFn = (typeof(hookmetamethod) == "function") and hookmetamethod or nil
    local getNamecallMethodFn = (typeof(getnamecallmethod) == "function") and getnamecallmethod or nil
    local checkCallerFn = (typeof(checkcaller) == "function") and checkcaller or nil

    if hookFn and getNamecallMethodFn then
        pcall(function()
            local oldNamecall
            oldNamecall = hookFn(game, "__namecall", function(self, ...)
                if Hub.cleaned then
                    return oldNamecall(self, ...)
                end
                if checkCallerFn and checkCallerFn() then
                    return oldNamecall(self, ...)
                end

                if SilentAim and SilentTargetPos and self == workspace and rollSilentHitChance() then
                    local method = getNamecallMethodFn()
                    local args = {...}

                    if method == "Raycast" and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                        local origin = args[1]
                        local dist = args[2].Magnitude
                        local dirUnit = (SilentTargetPos - origin).Unit
                        args[2] = dirUnit * math.max(dist, 1)
                        return oldNamecall(self, table.unpack(args))
                    elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and typeof(args[1]) == "Ray" then
                        local rayObj = args[1]
                        local dist = rayObj.Direction.Magnitude
                        local dirUnit = (SilentTargetPos - rayObj.Origin).Unit
                        args[1] = Ray.new(rayObj.Origin, dirUnit * math.max(dist, 1))
                        return oldNamecall(self, table.unpack(args))
                    end
                end

                return oldNamecall(self, ...)
            end)
        end)
    end
end

local function getPingMs()
    local pingVal = 0
    pcall(function()
        local net = Stats and Stats:FindFirstChild("Network")
        if net and net:FindFirstChild("ServerStatsItem") then
            local dataPing = net.ServerStatsItem:FindFirstChild("Data Ping")
            if dataPing and typeof(dataPing.GetValue) == "function" then
                pingVal = math.floor(dataPing:GetValue() + 0.5)
            end
        end
    end)
    return pingVal
end

local function joinAnotherServer(statusCallback)
    task.spawn(function()
        local placeId = game.PlaceId
        local currentJobId = game.JobId
        if statusCallback then
            statusCallback("Finding...")
        end

        local targetJobId = nil
        local httpGetter = game.HttpGet
        if typeof(httpGetter) == "function" then
            pcall(function()
                local url = string.format(
                    "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
                    placeId
                )
                local raw = httpGetter(game, url)
                local decoded = HttpService:JSONDecode(raw)
                if decoded and typeof(decoded.data) == "table" then
                    for _, srv in ipairs(decoded.data) do
                        if typeof(srv) == "table"
                            and typeof(srv.id) == "string"
                            and srv.id ~= currentJobId
                            and tonumber(srv.playing)
                            and tonumber(srv.maxPlayers)
                            and srv.playing < srv.maxPlayers
                        then
                            targetJobId = srv.id
                            break
                        end
                    end
                end
            end)
        end

        if statusCallback then
            statusCallback("Joining...")
        end

        local ok = false
        if targetJobId then
            ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, targetJobId, LocalPlayer)
            end)
        end
        if not ok then
            pcall(function()
                TeleportService:Teleport(placeId, LocalPlayer)
            end)
        end
    end)
end

