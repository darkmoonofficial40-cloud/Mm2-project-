local function addSlider(page, labelText, minVal, maxVal, increment, defaultVal, callback)
	increment = increment or 1
	local value = math.clamp(defaultVal or minVal, minVal, maxVal)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 44)
	frame.BackgroundColor3 = Color3.fromRGB(26, 30, 42)
	frame.BorderSizePixel = 0
	frame.Parent = page
	addCorner(frame, 7)
	addStroke(frame, Color3.fromRGB(45, 55, 72), 1, 0.4)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.7, 0, 0, 18)
	title.Position = UDim2.new(0, 10, 0, 3)
	title.BackgroundTransparency = 1
	title.Text = labelText
	title.TextColor3 = Color3.fromRGB(226, 232, 240)
	title.Font = Enum.Font.GothamMedium
	title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local valLabel = Instance.new("TextLabel")
	valLabel.Size = UDim2.new(0.3, -10, 0, 18)
	valLabel.Position = UDim2.new(0.7, 0, 0, 3)
	valLabel.BackgroundTransparency = 1
	valLabel.Text = tostring(value)
	valLabel.TextColor3 = Color3.fromRGB(129, 140, 248)
	valLabel.Font = Enum.Font.GothamBold
	valLabel.TextSize = 12
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.Parent = frame

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -20, 0, 5)
	track.Position = UDim2.new(0, 10, 0, 29)
	track.BackgroundColor3 = Color3.fromRGB(51, 65, 85)
	track.BorderSizePixel = 0
	track.Parent = frame
	addCorner(track, 99)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(99, 102, 241)
	fill.BorderSizePixel = 0
	fill.Parent = track
	addCorner(fill, 99)

	local draggingSlider = false

	local function setFromAlpha(alpha)
		alpha = math.clamp(alpha, 0, 1)
		local raw = minVal + (maxVal - minVal) * alpha
		local stepped = math.floor((raw / increment) + 0.5) * increment
		stepped = math.clamp(stepped, minVal, maxVal)
		value = stepped
		local ratio = (value - minVal) / math.max((maxVal - minVal), 1e-6)
		fill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
		valLabel.Text = tostring(value)
		if callback then
			callback(value)
		end
	end

	setFromAlpha((value - minVal) / math.max((maxVal - minVal), 1e-6))

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
			local relX = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
			setFromAlpha(relX)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local relX = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
			setFromAlpha(relX)
		end
	end)
end

