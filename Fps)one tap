		if part and part.Parent then
			pcall(function()
				part.CanCollide = origCollide
			end)
		end
		SavedCollide[part] = nil
	end
end

local function applyCharacterMovement(char)
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local targetSpeed = SpeedEnabled and SpeedValue or DefaultWalkSpeed
	if hum.WalkSpeed ~= targetSpeed then
		hum.WalkSpeed = targetSpeed
	end

	if not hum.UseJumpPower then
		hum.UseJumpPower = true
	end
	local targetJump = JumpEnabled and JumpValue or DefaultJumpPower
	if hum.JumpPower ~= targetJump then
		hum.JumpPower = targetJump
	end
end

