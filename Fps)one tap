	end
end

local function restoreCharacterCollisions()
	for part, origCollide in pairs(SavedCollide) do
		if part and part.Parent then
			pcall(function()
				part.CanCollide = origCollide
			end)
		end
		SavedCollide[part] = nil
	end
end

