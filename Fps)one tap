local function makeLine(color, thickness, zIndex)
	local line = Drawing.new("Line")
	line.Visible = false
	line.Color = color
	line.Thickness = thickness or 1.5
	if zIndex and line.ZIndex ~= nil then
		line.ZIndex = zIndex
	end
	return line
end

