-- Single Unified & Phone-Optimized Frame Loop
do
	local frameCount = 0
	local statsElapsed = 0
	local noclipElapsed = 0

	RunService.RenderStepped:Connect(function(dt)
		Camera = workspace.CurrentCamera
		if not Camera then
			return
		end

		-- Throttled Stats Bar Update (reduces mobile UI overhead)
		frameCount += 1
		statsElapsed += dt
		if statsElapsed >= 0.75 then
			local fps = math.floor((frameCount / statsElapsed) + 0.5)
			local ping = getPingMs()
			local activePlayers = #Players:GetPlayers()
			StatsLabel.Text = string.format("FPS: %d | Ping: %dms | Players: %d", fps, ping, activePlayers)
			frameCount = 0
			statsElapsed = 0
		end

		-- Movement & Throttled Noclip
		local char = LocalPlayer.Character
		if char then
			applyCharacterMovement(char)

			if Noclip then
				noclipElapsed += dt
				if noclipElapsed >= 0.1 then
					noclipElapsed = 0
					for _, desc in ipairs(char:GetDescendants()) do
						if desc:IsA("BasePart") then
							if SavedCollide[desc] == nil then
								SavedCollide[desc] = desc.CanCollide
							end
							if desc.CanCollide then
								desc.CanCollide = false
							end
						end
					end
				end
			end
		end

		local screenCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
		local showFov = Aimbot or SilentAim
		Circle.Visible = showFov
		GlowCircle.Visible = showFov

		if showFov then
			Circle.Position = screenCenter
			Circle.Radius = AimFOV
			GlowCircle.Position = screenCenter
			GlowCircle.Radius = AimFOV

			if RainbowFOV then
				local col = Color3.fromHSV((os.clock() % 5) / 5, 1, 1)
				Circle.Color = col
				GlowCircle.Color = col
			else
				local red = Color3.fromRGB(255, 0, 0)
				Circle.Color = red
				GlowCircle.Color = red
			end
		end

		if Crosshair then
			local gap = 4
			local arm = 10
			CrosshairH.From = Vector2.new(screenCenter.X - (gap + arm), screenCenter.Y)
			CrosshairH.To = Vector2.new(screenCenter.X + (gap + arm), screenCenter.Y)
			CrosshairV.From = Vector2.new(screenCenter.X, screenCenter.Y - (gap + arm))
			CrosshairV.To = Vector2.new(screenCenter.X, screenCenter.Y + (gap + arm))
			CrosshairH.Visible = true
			CrosshairV.Visible = true
		else
			CrosshairH.Visible = false
			CrosshairV.Visible = false
		end

		if Aimbot or SilentAim then
			local targetPos = getClosestTarget(screenCenter)
			SilentTargetPos = SilentAim and targetPos or nil
			if Aimbot and targetPos then
				Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
			end
		else
			SilentTargetPos = nil
		end

		-- Skip player visual loop completely when disabled
		if not (ESP or SkeletonESP or Tracers) then
			return
		end

		local localRoot = char and char:FindFirstChild("HumanoidRootPart")
		local tracerOrigin = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y)

		for _, p in ipairs(Players:GetPlayers()) do
			local pChar = (p ~= LocalPlayer) and p.Character or nil
			local hrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
			local hum = pChar and pChar:FindFirstChildOfClass("Humanoid")
			local validAlive = (hrp and hum and hum.Health > 0)

			local rootPos, onScreen, topPos, bottomPos, width, height
			if validAlive then
				rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				topPos = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, 3, 0)).Position)
				bottomPos = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, -3.5, 0)).Position)
				if onScreen and rootPos.Z > 0 then
					height = math.clamp(math.abs(bottomPos.Y - topPos.Y), 14, 600)
					width = math.clamp(height * 0.55, 10, 400)
				else
					onScreen = false
				end
			end

			-- CS2 Box + Green HP Line + White Name & Distance
			if ESP then
				if not ESPCache[p] then
					ESPCache[p] = createESPObjects()
				end
				local entry = ESPCache[p]
				if validAlive and onScreen then
					local boxX = rootPos.X - (width * 0.5)
					local boxY = topPos.Y

					entry.Box.Size = Vector2.new(width, height)
					entry.Box.Position = Vector2.new(boxX, boxY)
					entry.Box.Color = CS2_Red
					entry.Box.Visible = true

					local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
					local hpX = math.max(boxX - 5, 2)
					local hpBottomY = boxY + height
					local hpTopY = hpBottomY - (height * hpRatio)

					entry.HpBg.From = Vector2.new(hpX, boxY)
					entry.HpBg.To = Vector2.new(hpX, hpBottomY)
					entry.HpBg.Visible = true

					entry.HpBar.From = Vector2.new(hpX, hpBottomY)
					entry.HpBar.To = Vector2.new(hpX, hpTopY)
					entry.HpBar.Color = CS2_Green
					entry.HpBar.Visible = true

					local distText = ""
					if localRoot then
						local studs = math.floor((localRoot.Position - hrp.Position).Magnitude)
						distText = " [" .. tostring(studs) .. "m]"
					end

					entry.Label.Text = p.Name .. distText
					entry.Label.Color = CS2_White
					entry.Label.Position = Vector2.new(rootPos.X, math.max(boxY - 15, 4))
					entry.Label.Visible = true
				else
					hideESPEntry(entry)
				end
			elseif ESPCache[p] then
				hideESPEntry(ESPCache[p])
			end

			-- Skeleton ESP (Red Bones)
			if SkeletonESP then
				if validAlive and onScreen then
					local bonePairs = buildCharacterBones(pChar)
					local needed = #bonePairs
					if not SkeletonCache[p] then
						SkeletonCache[p] = createSkeletonObjects(needed)
					elseif #SkeletonCache[p] < needed then
						for idx = #SkeletonCache[p] + 1, needed do
							SkeletonCache[p][idx] = makeLine(CS2_Red, 1.5, 2)
						end
					end

					local lines = SkeletonCache[p]
					for idx = 1, #lines do
						local line = lines[idx]
						local pair = bonePairs[idx]
						if pair then
							local p1Screen, vis1 = Camera:WorldToViewportPoint(pair[1])
							local p2Screen, vis2 = Camera:WorldToViewportPoint(pair[2])
							if vis1 and vis2 and p1Screen.Z > 0 and p2Screen.Z > 0 then
								line.From = Vector2.new(p1Screen.X, p1Screen.Y)
								line.To = Vector2.new(p2Screen.X, p2Screen.Y)
								line.Color = CS2_Red
								line.Visible = true
							else
								line.Visible = false
							end
						else
							line.Visible = false
						end
					end
				elseif SkeletonCache[p] then
					hideSkeleton(SkeletonCache[p])
				end
			elseif SkeletonCache[p] then
				hideSkeleton(SkeletonCache[p])
			end

			-- Tracers
			if Tracers then
				if not TracerCache[p] then
					TracerCache[p] = createTracerLine()
				end
				local line = TracerCache[p]
				if validAlive and onScreen then
					line.From = tracerOrigin
					line.To = Vector2.new(rootPos.X, bottomPos.Y)
					line.Color = CS2_Red
					line.Visible = true
				else
					line.Visible = false
				end
			elseif TracerCache[p] then
				TracerCache[p].Visible = false
			end
		end
	end)
end
