-- Moon Logo Toggle Button (Drag Support + Keybind)
local function setWindowVisible(vis)
	MainFrame.Visible = vis
	MoonDisc.BackgroundTransparency = vis and 0 or 0.25
	MoonOuterStroke.Color = vis and Color3.fromRGB(165, 180, 252) or Color3.fromRGB(99, 102, 241)
	MoonOuterStroke.Transparency = vis and 0.1 or 0.45
end

do
	local btnDragging = false
	local movedEnough = false
	local btnDragInput = nil
	local btnDragStart = nil
	local btnStartPos = nil

	ToggleBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			btnDragging = true
			movedEnough = false
			btnDragStart = input.Position
			btnStartPos = MoonToggleHolder.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					local wasDragged = movedEnough
					btnDragging = false
					if not wasDragged then
						setWindowVisible(not MainFrame.Visible)
					end
				end
			end)
		end
	end)

	ToggleBtn.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			btnDragInput = input
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if input == btnDragInput and btnDragging then
			local delta = input.Position - btnDragStart
			if delta.Magnitude > 6 then
				movedEnough = true
			end
			MoonToggleHolder.Position = UDim2.new(
				btnStartPos.X.Scale,
				btnStartPos.X.Offset + delta.X,
				btnStartPos.Y.Scale,
				btnStartPos.Y.Offset + delta.Y
			)
		end
	end)
end

UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
		setWindowVisible(not MainFrame.Visible)
	end
end)

-- Dragging for Main Window
do
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil

	Header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = MainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	Header.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			MainFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

-- Unified Optimized Render Loop
local frameCount = 0
local statsElapsed = 0
local moveElapsed = 0
local lastPing = 0

RunService.RenderStepped:Connect(function(dt)
	Camera = workspace.CurrentCamera
	if not Camera then return end

	frameCount += 1
	statsElapsed += dt
	moveElapsed += dt

	if statsElapsed >= 0.75 then
		local fps = math.floor((frameCount / statsElapsed) + 0.5)
		lastPing = getPingMs()
		StatsLabel.Text = string.format("FPS: %d | Ping: %dms | Players: %d", fps, lastPing, #Players:GetPlayers())
		frameCount = 0
		statsElapsed = 0
	end

	local char = LocalPlayer.Character
	if char and moveElapsed >= 0.1 then
		moveElapsed = 0
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			if hum.WalkSpeed ~= SpeedValue then
				hum.WalkSpeed = SpeedValue
			end
			if not hum.UseJumpPower then
				hum.UseJumpPower = true
			end
			if hum.JumpPower ~= JumpValue then
				hum.JumpPower = JumpValue
			end
		end

		if Noclip then
			for _, desc in ipairs(char:GetDescendants()) do
				if desc:IsA("BasePart") then
					if SavedCollide[desc] == nil then
						SavedCollide[desc] = desc.CanCollide
					end
					if desc.CanCollide then
						desc.CanCollide = false
					end
				end
			end
		end
	end

	local vp = Camera.ViewportSize
	local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)

	if Aimbot then
		Circle.Position = screenCenter
		Circle.Radius = AimFOV
		GlowCircle.Position = screenCenter
		GlowCircle.Radius = AimFOV

		local fovColor
		if RainbowFOV then
			fovColor = Color3.fromHSV((os.clock() % 5) / 5, 1, 1)
		else
			fovColor = Color3.fromRGB(255, 0, 0)
		end
		Circle.Color = fovColor
		GlowCircle.Color = fovColor

		local closestPart = nil
		local shortestDistance = AimFOV

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local head = player.Character:FindFirstChild("Head")
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				if head and hum and hum.Health > 0 then
					local pos, visible = Camera:WorldToViewportPoint(head.Position)
					if visible and pos.Z > 0 and WallCheck(head.Position, player.Character) then
						local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
						if dist < shortestDistance then
							shortestDistance = dist
							closestPart = head
						end
					end
				end
			end
		end

		if closestPart then
			local aimPosition = closestPart.Position
			if Prediction then
				local dist3D = (Camera.CFrame.Position - closestPart.Position).Magnitude
				aimPosition = closestPart.Position + (closestPart.AssemblyLinearVelocity * (dist3D / BulletSpeed))
			end
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)
		end
	end

	if Crosshair then
		local gap = 4
		local arm = 10
		CrosshairH.From = Vector2.new(screenCenter.X - (gap + arm), screenCenter.Y)
		CrosshairH.To = Vector2.new(screenCenter.X + (gap + arm), screenCenter.Y)
		CrosshairV.From = Vector2.new(screenCenter.X, screenCenter.Y - (gap + arm))
		CrosshairV.To = Vector2.new(screenCenter.X, screenCenter.Y + (gap + arm))
	end

	if ESP or Tracers then
		local localRoot = char and char:FindFirstChild("HumanoidRootPart")
		local tracerOrigin = Vector2.new(vp.X * 0.5, vp.Y)

		for _, p in ipairs(Players:GetPlayers()) do
			local pChar = (p ~= LocalPlayer) and p.Character or nil
			local hrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
			local hum = pChar and pChar:FindFirstChildOfClass("Humanoid")
			local validAlive = (hrp and hum and hum.Health > 0)

			local rootPos, onScreen, topPos, bottomPos, width, height
			if validAlive then
				rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				if onScreen and rootPos.Z > 0 then
					topPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
					bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
					height = math.clamp(math.abs(bottomPos.Y - topPos.Y), 14, 600)
					width = math.clamp(height * 0.55, 10, 400)
				else
					onScreen = false
				end
			end

			if ESP then
				if not ESPCache[p] then
					ESPCache[p] = createESPObjects()
				end
				local entry = ESPCache[p]
				if validAlive and onScreen then
					local boxX = rootPos.X - (width * 0.5)
					local boxY = topPos.Y
					entry.Box.Size = Vector2.new(width, height)
					entry.Box.Position = Vector2.new(boxX, boxY)
					entry.Box.Visible = true

					local distText = ""
					if localRoot then
						distText = " [" .. tostring(math.floor((localRoot.Position - hrp.Position).Magnitude)) .. "m]"
					end
					entry.Label.Text = p.Name .. distText
					entry.Label.Position = Vector2.new(rootPos.X, math.max(boxY - 14, 4))
					entry.Label.Visible = true
				else
					entry.Box.Visible = false
					entry.Label.Visible = false
				end
			elseif ESPCache[p] then
				ESPCache[p].Box.Visible = false
				ESPCache[p].Label.Visible = false
			end

			if Tracers then
				if not TracerCache[p] then
					TracerCache[p] = createTracerLine()
				end
				local line = TracerCache[p]
				if validAlive and onScreen then
					line.From = tracerOrigin
					line.To = Vector2.new(rootPos.X, bottomPos.Y)
					line.Visible = true
				else
					line.Visible = false
				end
			elseif TracerCache[p] then
				TracerCache[p].Visible = false
			end
		end
	end
end)
