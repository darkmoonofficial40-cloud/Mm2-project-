local function getHealthColor(ratio)
    ratio = math.clamp(ratio, 0, 1)
    if ratio > 0.5 then
        local t = (ratio - 0.5) * 2
        return Color3.fromRGB(
            math.floor(250 - (216 * t)),
            204,
            math.floor(21 + (73 * t))
        )
    else
        local t = ratio * 2
        return Color3.fromRGB(
            239,
            math.floor(68 + (136 * t)),
            math.floor(68 - (47 * t))
        )
    end
end

