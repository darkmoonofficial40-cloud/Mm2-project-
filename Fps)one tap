local function hideESPEntry(entry)
	if not entry then return end
	if entry.Box then entry.Box.Visible = false end
	if entry.HpBg then entry.HpBg.Visible = false end
	if entry.HpBar then entry.HpBar.Visible = false end
	if entry.Label then entry.Label.Visible = false end
end

local function removeESPEntry(entry)
	if not entry then return end
	if entry.Box then pcall(function() entry.Box:Remove() end) end
	if entry.HpBg then pcall(function() entry.HpBg:Remove() end) end
	if entry.HpBar then pcall(function() entry.HpBar:Remove() end) end
	if entry.Label then pcall(function() entry.Label:Remove() end) end
end

