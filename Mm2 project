createToggle(espContainer, "DROPPED GUN ESP", function(state) espStates.Gun = state end)

RunService.RenderStepped:Connect(function()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
			local role = getRole(plr)
			local highlight = plr.Character:FindFirstChild("YutaESP")

			createOverheadEsp(plr)
			local nametag = plr.Character.Head:FindFirstChild("YutaNametag")

			if espStates[role] then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = "YutaESP"
					highlight.Parent = plr.Character
				end
				highlight.Enabled = true

				local color = (role == "Murderer" and Color3.fromRGB(255, 50, 50)) or
					(role == "Sheriff" and Color3.fromRGB(50, 120, 255)) or
					Color3.fromRGB(50, 255, 50)

				highlight.FillColor = color

				if nametag then
					nametag.Enabled = true
					local roleLabel = nametag.MainFrame.RoleLabel
					local avatarStroke = nametag.MainFrame.AvatarPreview.BorderStroke

					roleLabel.Text = string.upper(role)
					roleLabel.TextColor3 = color
					avatarStroke.Color = color
				end
			else
				if highlight then highlight.Enabled = false end
				if nametag then nametag.Enabled = false end
			end
		end
	end

	if espStates.Gun then
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("Tool") and (obj.Name == "GunDrop" or obj.Name == "Gun") and not obj:IsDescendantOf(Players) then
				local hl = obj:FindFirstChild("GunESP")
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "GunESP"
					hl.FillColor = Color3.fromRGB(255, 255, 0)
					hl.Parent = obj
				end
			end
		end
	end
end)

local triggerbotActive = false
