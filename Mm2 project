local function GetPlayerRole(player)
    local char = player.Character
    if not char then return "INOCENTE", ESP.InnocentColor end
    
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("knife") or name:find("faca") then 
                    return "MURDER", ESP.MurderColor 
                end
                if name:find("gun") or name:find("revolver") or name:find("pistol") or 
                   name:find("sheriff") or name:find("deagle") then 
                    return "SHERIFF", ESP.SheriffColor 
                end
            end
        end
    end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("knife") or name:find("faca") then 
                return "MURDER", ESP.MurderColor 
            end
            if name:find("gun") or name:find("revolver") or name:find("pistol") or 
               name:find("sheriff") or name:find("deagle") then 
                return "SHERIFF", ESP.SheriffColor 
            end
        end
    end
    
    local role = char:FindFirstChild("Role")
    if role then
        if role.Value == "Murderer" then return "MURDER", ESP.MurderColor end
        if role.Value == "Sheriff" then return "SHERIFF", ESP.SheriffColor end
        if role.Value == "Innocent" then return "INOCENTE", ESP.InnocentColor end
    end
    
    return "INOCENTE", ESP.InnocentColor
end

local function GetMyRole()
    return GetPlayerRole(LocalPlayer)
end

