-- 3D Depth Helper: adds a layered drop shadow + top bevel highlight for physical depth
local function apply3DDepth(targetFrame, cornerRadius, shadowOffsetY, shadowColor, bevelColor)
	local shadow = Instance.new("Frame")
	shadow.Name = "DepthShadow3D"
	shadow.Size = UDim2.new(1, 4, 1, 4)
	shadow.Position = UDim2.new(0, 0, 0, shadowOffsetY or 5)
	shadow.BackgroundColor3 = shadowColor or Color3.fromRGB(4, 6, 10)
	shadow.BackgroundTransparency = 0.35
	shadow.BorderSizePixel = 0
	shadow.ZIndex = math.max(1, targetFrame.ZIndex - 1)
	shadow.Parent = targetFrame

	local sCorner = Instance.new("UICorner")
	sCorner.CornerRadius = UDim.new(0, cornerRadius or 10)
	sCorner.Parent = shadow

	local stroke = Instance.new("UIStroke")
	stroke.Color = bevelColor or Color3.fromRGB(95, 115, 150)
	stroke.Thickness = 1.2
	stroke.Transparency = 0.25
	stroke.Parent = targetFrame

	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.15, Color3.fromRGB(215, 225, 240)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(130, 145, 170))
	}
	grad.Parent = stroke
end

