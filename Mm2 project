RunService.Heartbeat:Connect(function()
	if not triggerbotActive or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
	local myHRP = LocalPlayer.Character.HumanoidRootPart

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and getRole(plr) == "Murderer" and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local mHRP = plr.Character.HumanoidRootPart
			if (myHRP.Position - mHRP.Position).Magnitude <= 4.5 then
				local escapeDir = (myHRP.Position - mHRP.Position).Unit
				myHRP.CFrame = myHRP.CFrame + (escapeDir * 25) + Vector3.new(0, 5, 0)
			end
		end
	end
end)

