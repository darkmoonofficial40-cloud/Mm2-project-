-- 💰 AUTO FARM (COM PROTEÇÃO INVALID POSITION)
-- ============================================
local collectedCoins = {}
local isFrozen = false
local currentTarget = nil
local lastValidPosition = nil
local positionTimer = 0

local function GetAllCoins()
    local coins = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("coin") or name:find("moeda") or name:find("money") or name:find("cash") then
                if obj.Parent and obj.Parent:IsA("Model") then
                    local isCharacter = obj.Parent:FindFirstChild("Humanoid")
                    if not isCharacter and not collectedCoins[obj] then
                        table.insert(coins, obj)
                    end
                end
            end
        end
    end
    return coins
end

local function CollectCoin(coin, root)
    if not coin or not root then return false end
    
    collectedCoins[coin] = true
    
    pcall(function()
        -- Toque direto
        firetouchinterest(root, coin, 0)
        firetouchinterest(root, coin, 1)
        wait(0.01)
        firetouchinterest(root, coin, 0)
        firetouchinterest(root, coin, 1)
        
        -- Remover moeda
        if coin.Parent then
            coin:Destroy()
        end
    end)
    
    return true
end

-- 🔒 FUNÇÃO PARA VALIDAR POSIÇÃO
local function ValidatePosition(root)
    if not root then return false end
    
    local pos = root.Position
    -- Verifica se posição é válida
    if math.abs(pos.X) > 10000 or math.abs(pos.Z) > 10000 or pos.Y < -500 or pos.Y > 5000 then
        -- Posição inválida - corrigir
        if lastValidPosition then
            root.CFrame = CFrame.new(lastValidPosition)
            root.Velocity = Vector3.new(0, 0, 0)
        else
            root.CFrame = CFrame.new(0, 50, 0)
        end
        return false
    end
    
    lastValidPosition = pos
    return true
end

-- 💰 Loop Principal do Farm
spawn(function()
    while wait(0.01) do
        if Settings.FarmEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChild("Humanoid")
                if not root or not humanoid then return end
                
                -- 🔒 VALIDAR POSIÇÃO
                if not ValidatePosition(root) then
                    wait(0.1)
                    return
                end
                
                -- 🛡️ Anti-Ban: Esconder movimento
                if AntiBan.Active then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                    humanoid.PlatformStand = true
                end
                
                -- 🔍 Buscar moedas
                local allCoins = GetAllCoins()
                local nearestCoin = nil
                local minDist = math.huge
                
                for _, coin in pairs(allCoins) do
                    if coin and coin.Position then
                        local dist = (root.Position - coin.Position).Magnitude
                        if dist < minDist and dist < 500 then -- Limite de distância
                            minDist = dist
                            nearestCoin = coin
                        end
                    end
                end
                
                if nearestCoin then
                    -- 💰 TEM MOEDA - IR DIRETO
                    if isFrozen then
                        isFrozen = false
                        root.Anchored = false
                    end
                    
                    currentTarget = nearestCoin
                    local speed = math.min(Settings.FarmSpeed, 50)
                    
                    -- Calcula direção e valida
                    local direction = (nearestCoin.Position - root.Position).unit
                    local targetPos = root.Position + direction * speed * 0.1
                    
                    -- Verifica se target é válido
                    if math.abs(targetPos.X) < 10000 and math.abs(targetPos.Z) < 10000 and targetPos.Y > -100 then
                        root.Velocity = direction * speed
                    else
                        root.Velocity = Vector3.new(0, 0, 0)
                    end
                    
                    -- Coletar quando estiver perto
                    if minDist < 6 then
                        CollectCoin(nearestCoin, root)
                        root.Velocity = Vector3.new(0, 0, 0)
                        wait(0.01)
                    end
                    
                else
                    -- 🌙 SEM MOEDAS - PARADO DEITADO
                    if not isFrozen then
                        isFrozen = true
                        
                        -- Parar imediatamente
                        root.Velocity = Vector3.new(0, 0, 0)
                        root.Anchored = true
                        
                        -- Deitar
                        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(90), 0, 0)
                        
                        -- Congelar todas as partes
                        for _, part in pairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.Velocity = Vector3.new(0, 0, 0)
                                part.RotVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
            end)
        else
            -- 🛑 DESLIGAR FARM
            if isFrozen then
                pcall(function()
                    local char = LocalPlayer.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        local humanoid = char:FindFirstChild("Humanoid")
                        if root then
                            root.Anchored = false
                            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(-90), 0, 0)
                        end
                        if humanoid then
                            humanoid.PlatformStand = false
                        end
                    end
                end)
                isFrozen = false
                currentTarget = nil
            end
        end
    end
end)

