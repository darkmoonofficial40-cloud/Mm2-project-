local ESPObjects = {}

local function CreateRoleESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    
    local roleText = Drawing.new("Text")
    roleText.Size = 20
    roleText.Outline = true
    roleText.OutlineColor = Color3.fromRGB(0, 0, 0)
    roleText.Center = true
    roleText.Font = 2
    roleText.Visible = false
    ESPObjects[player] = roleText
    
    RunService.RenderStepped:Connect(function()
        if player.Parent == nil then
            pcall(function() roleText:Remove() end)
            ESPObjects[player] = nil
            return
        end
        
        if not ESP.RoleESP then
            roleText.Visible = false
            return
        end
        
        local char = player.Character
        if not char then
            roleText.Visible = false
            return
        end
        
        local head = char:FindFirstChild("Head")
        if not head then
            roleText.Visible = false
            return
        end
        
        local pos, onScreen = Camera:WorldToScreenPoint(head.Position)
        if onScreen then
            local role, color = GetPlayerRole(player)
            roleText.Text = role
            roleText.Color = color
            roleText.Position = Vector2.new(pos.X, pos.Y - 45)
            roleText.Visible = true
        else
            roleText.Visible = false
        end
    end)
end

