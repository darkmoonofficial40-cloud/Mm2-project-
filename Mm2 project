-- 🔒 SPOOF DE POSIÇÃO PARA EVITAR KICK
local function SpoofPosition()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        -- Guarda posição real
        local realPos = root.Position
        
        -- Cria posição falsa para o servidor
        spawn(function()
            while AntiBan.Active do
                wait(0.03)
                if root then
                    -- Envia posição falsa suavemente
                    local fakePos = root.Position + Vector3.new(
                        math.random(-1, 1) * 0.1,
                        math.random(-1, 1) * 0.1,
                        math.random(-1, 1) * 0.1
                    )
                    root:SetAttribute("FakePosition", fakePos)
                    
                    -- Spoof via CFrame
                    local fakeCF = CFrame.new(fakePos) * CFrame.Angles(0, math.rad(math.random(-2, 2)), 0)
                    root:SetAttribute("FakeCFrame", fakeCF)
                end
            end
        end)
    end)
end

-- 🚫 BLOQUEAR DETECÇÃO DE POSIÇÃO INVALIDA
local function BlockInvalidPosition()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        -- 🔒 Metatabela para esconder posição real
        local mt = getrawmetatable(game)
        if mt then
            local oldIndex = mt.__index
            local oldNewIndex = mt.__newindex
            
            mt.__index = function(self, key)
                if key == "Position" and self == root then
                    return root:GetAttribute("FakePosition") or root.Position
                end
                if key == "CFrame" and self == root then
                    return root:GetAttribute("FakeCFrame") or root.CFrame
                end
                if key == "Velocity" and self == root then
                    return Vector3.new(0, 0, 0)
                end
                if key == "MoveDirection" then
                    return Vector3.new(0, 0, 0)
                end
                return oldIndex(self, key)
            end
            
            mt.__newindex = function(self, key, value)
                if key == "Position" and self == root then
                    root:SetAttribute("FakePosition", value)
                    return
                end
                if key == "CFrame" and self == root then
                    root:SetAttribute("FakeCFrame", value)
                    return
                end
                if key == "Velocity" and self == root then
                    return
                end
                return oldNewIndex(self, key, value)
            end
        end
        
        -- Impedir detecção de posição inválida
        root:SetAttribute("PositionCheck", "valid")
    end)
end

-- 🛡️ ANTI-KICK COMPLETO
local function AntiKick()
    pcall(function()
        -- Prevenir kicks por posição inválida
        local function preventKick()
            -- Verifica se está sendo kickado
            local kickDetected = false
            
            -- Monitora mensagens de erro
            game:GetService("LogService").MessageOut:Connect(function(message)
                if message and string.find(message:lower(), "invalid position") then
                    kickDetected = true
                    wait(0.1)
                    -- Tenta reconectar
                    pcall(function()
                        local char = LocalPlayer.Character
                        if char then
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if root then
                                -- Move ligeiramente para corrigir posição
                                root.CFrame = root.CFrame + Vector3.new(0, 1, 0)
                                wait(0.05)
                                root.CFrame = root.CFrame - Vector3.new(0, 1, 0)
                            end
                        end
                    end)
                end
            end)
        end
        
        -- Spawn do anti-kick
        spawn(preventKick)
        
        -- Verificação periódica de posição
        spawn(function()
            while AntiBan.Active do
                wait(1)
                pcall(function()
                    local char = LocalPlayer.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            -- Verifica se posição é válida
                            local pos = root.Position
                            if math.abs(pos.X) > 10000 or math.abs(pos.Z) > 10000 or pos.Y < -1000 then
                                -- Posição inválida, corrigir
                                root.CFrame = CFrame.new(0, 50, 0)
                                wait(0.1)
                                root.CFrame = CFrame.new(0, 0, 0)
                            end
                        end
                    end
                end)
            end
        end)
    end)
end

